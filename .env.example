# PostgreSQL
DATABASE_URL=postgresql://laserena:laserena@localhost:5432/laserena?schema=public

# Servidor
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Autenticación del dashboard
JWT_SECRET=cambiar-por-un-secreto-largo-de-al-menos-32-caracteres
JWT_EXPIRES_IN=12h

# Administrador inicial (se crea en el seed si no existe)
ADMIN_EMAIL=admin@laserena.local
ADMIN_PASSWORD=cambiar-esta-clave

# Token para llamadas entre servicios (whatsapp-bot -> api-central)
INTERNAL_API_TOKEN=cambiar-token-interno
